# syscheck: passwordless access for the analysis account (@USER@) to two
# root-owned scripts, so the scheduled analysis can read SMART data and
# root-only logs, and `syscheck run` works without a password.
#
# priv-read.sh accepts only a fixed list of read-only subcommands, and both
# files are root-owned 0755 in a root-owned directory, so this grant cannot
# be widened from the user side. Generated by /opt/syscheck/bin/apply.sh.
@USER@ ALL=(root) NOPASSWD: /opt/syscheck/bin/priv-read.sh
@USER@ ALL=(root) NOPASSWD: /opt/syscheck/bin/run.sh
